marks <- c(55,60,71,63,55,65,50,55,58,59,61,63,65,67,71,72,75)

marks_sorted <- sort(marks)

bin1 <- marks_sorted[1:6]
bin2 <- marks_sorted[7:12]
bin3 <- marks_sorted[13:17]

width <- (max(marks) - min(marks)) / 3
breaks <- seq(min(marks), max(marks), length.out=4)

cat("Name = Parveen\n")
cat("Register Number = 192325150\n")
cat("Course = CSA1604-DWDM\n\n")

cat("Equal-Frequency Partitioning\n")
cat("Bin 1 =", bin1, "\n")
cat("Bin 2 =", bin2, "\n")
cat("Bin 3 =", bin3, "\n\n")

cat("Equal-Width Partitioning\n")
cat("Minimum =", min(marks), "\n")
cat("Maximum =", max(marks), "\n")
cat("Bin Width =", width, "\n")
cat("Breaks =", breaks, "\n")

par(mfrow=c(1,2))

hist(marks,
     breaks=c(49.5,59.5,65.5,75.5),
     main="Equal-Frequency",
     xlab="Marks",
     ylab="Frequency")

hist(marks,
     breaks=breaks,
     include.lowest=TRUE,
     main="Equal-Width",
     xlab="Marks",
     ylab="Frequency")

par(mfrow=c(1,1))
