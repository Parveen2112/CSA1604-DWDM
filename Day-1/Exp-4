x <- sort(c(11,13,13,15,15,16,19,20,20,20,21,21,22,23,24,30,40,45,45,45,71,72,73,75))

b1 <- x[1:8]
b2 <- x[9:16]
b3 <- x[17:24]

mean_smooth <- c(rep(mean(b1),8),rep(mean(b2),8),rep(mean(b3),8))
median_smooth <- c(rep(median(b1),8),rep(median(b2),8),rep(median(b3),8))

boundary <- function(b) {
  a <- min(b)
  c <- max(b)
  ifelse(abs(b-a) <= abs(b-c),a,c)
}

boundary_smooth <- c(boundary(b1),boundary(b2),boundary(b3))

cat("Smoothing by Bin Mean:\n")
print(mean_smooth)

cat("\nSmoothing by Bin Median:\n")
print(median_smooth)

cat("\nSmoothing by Bin Boundaries:\n")
print(boundary_smooth)
